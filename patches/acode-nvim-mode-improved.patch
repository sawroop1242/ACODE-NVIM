diff --git a/src/cm/nvim/msgpackRpc.ts b/src/cm/nvim/msgpackRpc.ts
new file mode 100644
index 0000000..daf4b77
--- /dev/null
+++ b/src/cm/nvim/msgpackRpc.ts
@@ -0,0 +1,88 @@
+import { decode, encode } from "@msgpack/msgpack";
+import { createTransport } from "../lsp/transport";
+import type { LspServerDefinition, TransportContext } from "../lsp/types";
+
+type NotifyHandler = (method: string, params: unknown[]) => void;
+
+interface RawTransportInterface {
+	sendRaw(bytes: Uint8Array): void;
+	subscribeRaw(handler: (data: Uint8Array) => void): void;
+	unsubscribeRaw(handler: (data: Uint8Array) => void): void;
+}
+
+export interface NvimRpcClient {
+	request(method: string, params: unknown[]): Promise<unknown>;
+	notify(method: string, params: unknown[]): void;
+	onNotification(handler: NotifyHandler): () => void;
+	dispose(): void;
+}
+
+/**
+ * msgpack-rpc, per the neovim/msgpack-rpc spec:
+ *   request:      [0, msgid, method, params]
+ *   response:     [1, msgid, error, result]
+ *   notification: [2, method, params]
+ */
+export async function connectNvimRpc(
+	server: LspServerDefinition,
+	context: TransportContext,
+): Promise<NvimRpcClient> {
+	const { transport, dispose, ready } = createTransport(server, context);
+	await ready;
+
+	const raw = transport as unknown as RawTransportInterface;
+	if (!raw.sendRaw || !raw.subscribeRaw) {
+		throw new Error(
+			"Transport was not created with { raw: true } — nvim's msgpack-rpc " +
+				"traffic requires byte-safe framing, not the UTF-8 `binary` mode.",
+		);
+	}
+
+	let nextMsgId = 0;
+	const pending = new Map<
+		number,
+		{ resolve: (v: unknown) => void; reject: (e: unknown) => void }
+	>();
+	const notifyHandlers = new Set<NotifyHandler>();
+
+	const onRaw = (bytes: Uint8Array) => {
+		const msg = decode(bytes) as unknown[];
+		const type = msg[0] as number;
+
+		if (type === 1) {
+			const [, msgid, error, result] = msg as [number, number, unknown, unknown];
+			const entry = pending.get(msgid);
+			if (!entry) return;
+			pending.delete(msgid);
+			if (error) entry.reject(error);
+			else entry.resolve(result);
+		} else if (type === 2) {
+			const [, method, params] = msg as [number, string, unknown[]];
+			notifyHandlers.forEach((handler) => handler(method, params));
+		}
+		// type === 0 (an incoming request from nvim, e.g. nvim_error_event)
+		// is intentionally unhandled here — add if/when a plugin needs it.
+	};
+	raw.subscribeRaw(onRaw);
+
+	return {
+		request(method, params) {
+			const msgid = nextMsgId++;
+			return new Promise((resolve, reject) => {
+				pending.set(msgid, { resolve, reject });
+				raw.sendRaw(encode([0, msgid, method, params]));
+			});
+		},
+		notify(method, params) {
+			raw.sendRaw(encode([2, method, params]));
+		},
+		onNotification(handler) {
+			notifyHandlers.add(handler);
+			return () => notifyHandlers.delete(handler);
+		},
+		dispose() {
+			raw.unsubscribeRaw(onRaw);
+			dispose();
+		},
+	};
+}
diff --git a/src/cm/nvim/nvimKeyNotation.ts b/src/cm/nvim/nvimKeyNotation.ts
new file mode 100644
index 0000000..64117df
--- /dev/null
+++ b/src/cm/nvim/nvimKeyNotation.ts
@@ -0,0 +1,84 @@
+/*
+ * Maps browser KeyboardEvents to Neovim's <key> notation (:help key-notation)
+ * so any keybinding you have in init.lua — leader mappings, multi-key
+ * sequences, custom maps — reaches nvim_input() correctly, not just the
+ * small hardcoded set (Esc/Enter/Tab/arrows) the first draft of this
+ * plugin covered.
+ *
+ * Known limitation: this listens on `keydown`, which is reliable for
+ * hardware/Bluetooth keyboards and most soft-keyboard letter/number keys.
+ * Some Android IME features — predictive-text suggestion chips, swipe
+ * typing, autocorrect popups — deliver text via `compositionend`/
+ * `beforeinput` instead of clean `keydown` events with a proper `e.key`,
+ * and will NOT be forwarded correctly by this alone. That's a separate,
+ * real problem worth testing for early, not something solved here.
+ */
+
+const NAMED_KEYS: Record<string, string> = {
+	Escape: "Esc",
+	Enter: "CR",
+	Backspace: "BS",
+	Tab: "Tab",
+	Delete: "Del",
+	Insert: "Insert",
+	Home: "Home",
+	End: "End",
+	PageUp: "PageUp",
+	PageDown: "PageDown",
+	ArrowUp: "Up",
+	ArrowDown: "Down",
+	ArrowLeft: "Left",
+	ArrowRight: "Right",
+};
+
+for (let i = 1; i <= 24; i++) {
+	NAMED_KEYS[`F${i}`] = `F${i}`;
+}
+
+// Modifier-only keydowns and IME/composition artifacts — never forwarded.
+const IGNORED_KEYS = new Set([
+	"Shift",
+	"Control",
+	"Alt",
+	"Meta",
+	"CapsLock",
+	"OS",
+	"ContextMenu",
+	"Unidentified",
+	"Dead",
+	"Process",
+	"AltGraph",
+	"NumLock",
+	"ScrollLock",
+	"Pause",
+]);
+
+function modifierPrefix(e: KeyboardEvent, includeShift: boolean): string {
+	let mods = "";
+	if (e.ctrlKey) mods += "C-";
+	if (e.altKey) mods += "M-";
+	if (includeShift && e.shiftKey) mods += "S-";
+	if (e.metaKey) mods += "D-"; // Cmd, on the rare Bluetooth Mac-layout keyboard
+	return mods;
+}
+
+export function toNvimKey(e: KeyboardEvent): string | null {
+	if (IGNORED_KEYS.has(e.key)) return null;
+
+	const named = NAMED_KEYS[e.key];
+	if (named) {
+		const mods = modifierPrefix(e, true);
+		return `<${mods}${named}>`;
+	}
+
+	if (e.key.length === 1) {
+		// e.key already reflects Shift for printable characters (Shift+1 → "!"),
+		// so Shift never gets its own prefix here — only Ctrl/Alt/Meta do.
+		const mods = modifierPrefix(e, false);
+		// Literal '<' must be escaped or nvim reads it as a token start.
+		const literal = e.key === "<" ? "lt" : e.key;
+		return mods ? `<${mods}${literal}>` : e.key === "<" ? "<lt>" : e.key;
+	}
+
+	return null;
+}
diff --git a/src/cm/nvim/nvimLsp.ts b/src/cm/nvim/nvimLsp.ts
new file mode 100644
index 0000000..f534545
--- /dev/null
+++ b/src/cm/nvim/nvimLsp.ts
@@ -0,0 +1,60 @@
+import { autocompletion, type CompletionSource } from "@codemirror/autocomplete";
+import { linter } from "@codemirror/lint";
+import { getActiveNvimPlugin } from "./nvimModePlugin";
+
+/*
+ * These read from whatever the active NvimModePlugin instance has already
+ * received over RPC (see nvimModePlugin.ts) — no separate connection, no
+ * separate LSP client. This is the piece that lets editorManager.js swap
+ * Acode's own LSP extensions for these when vim mode is on.
+ */
+
+export const nvimDiagnosticsExtension = linter((view) => {
+	return getActiveNvimPlugin()?.getDiagnostics() ?? [];
+});
+
+// LSP CompletionItemKind -> CodeMirror's completion `type` (drives the icon).
+const KIND_TO_CM_TYPE: Record<number, string> = {
+	2: "method",
+	3: "function",
+	5: "field",
+	6: "variable",
+	7: "class",
+	8: "interface",
+	9: "module",
+	10: "property",
+	13: "enum",
+	14: "keyword",
+	15: "text",
+	21: "constant",
+};
+
+const nvimCompletionSource: CompletionSource = async (context) => {
+	const plugin = getActiveNvimPlugin();
+	if (!plugin) return null;
+
+	const word = context.matchBefore(/[\w$]*/);
+	if (!context.explicit && (!word || word.from === word.to)) return null;
+
+	const items = await plugin.requestCompletion(context.pos);
+	if (!items.length) return null;
+
+	return {
+		from: word ? word.from : context.pos,
+		options: items.map((item) => ({
+			label: item.label,
+			apply: item.insertText ?? item.label,
+			detail: item.detail,
+			type: item.kind ? KIND_TO_CM_TYPE[item.kind] : undefined,
+		})),
+	};
+};
+
+export const nvimCompletionExtension = autocompletion({
+	override: [nvimCompletionSource],
+});
+
+export const nvimLspExtensions = [
+	nvimDiagnosticsExtension,
+	nvimCompletionExtension,
+];
diff --git a/src/cm/nvim/nvimModePlugin.ts b/src/cm/nvim/nvimModePlugin.ts
new file mode 100644
index 0000000..b1f9caf
--- /dev/null
+++ b/src/cm/nvim/nvimModePlugin.ts
@@ -0,0 +1,333 @@
+import type { Diagnostic } from "@codemirror/lint";
+import { forceLinting } from "@codemirror/lint";
+import { Prec } from "@codemirror/state";
+import { type EditorView, ViewPlugin, keymap } from "@codemirror/view";
+import { connectNvimRpc, type NvimRpcClient } from "./msgpackRpc";
+import { toNvimKey } from "./nvimKeyNotation";
+import { nvimServerDefinition } from "./nvimServer";
+import { ensureServerRunning } from "../lsp/serverLauncher";
+
+/*
+ * Neovim is the source of truth for buffer text, cursor, mode, diagnostics,
+ * and completion — the same split vscode-neovim uses against VSCode's
+ * Monaco. CodeMirror never mutates text on its own here; every keystroke
+ * goes to nvim_input() first, and this plugin only ever paints what
+ * nvim_buf_lines_event says actually changed. Diagnostics and completion
+ * now come from whatever LSP client your own init.lua already configures
+ * (nvim-lspconfig + Pyright, etc.) — Acode's separate LSP client is not
+ * used for files opened in vim mode; see editorManager.js's
+ * configureLspForFile for where that swap happens.
+ */
+
+const modeLabels: Record<string, string> = {
+	n: "NORMAL",
+	i: "INSERT",
+	v: "VISUAL",
+	V: "V-LINE",
+	R: "REPLACE",
+};
+
+interface NvimDiagnostic {
+	lnum: number;
+	col: number;
+	end_lnum?: number;
+	end_col?: number;
+	message: string;
+	severity: number; // 1=Error, 2=Warn, 3=Info, 4=Hint — vim.diagnostic.severity
+	source?: string;
+}
+
+const severityFromNvim = (s: number): Diagnostic["severity"] =>
+	s === 1 ? "error" : s === 2 ? "warning" : "info";
+
+export interface NvimCompletionItem {
+	label: string;
+	insertText?: string;
+	detail?: string;
+	kind?: number; // LSP CompletionItemKind
+}
+
+export class NvimModePlugin {
+	private client: NvimRpcClient | null = null;
+	private modeBar: HTMLDivElement;
+	private disposed = false;
+	private currentPath: string | null = null;
+	private connected: Promise<void>;
+
+	constructor(private view: EditorView) {
+		this.modeBar = document.createElement("div");
+		this.modeBar.className = "nvim-mode-bar";
+		this.modeBar.textContent = "-- connecting to nvim --";
+		view.dom.prepend(this.modeBar);
+		this.connected = this.connect();
+	}
+
+	private async connect() {
+		try {
+			const { discoveredPort } = await ensureServerRunning(
+				nvimServerDefinition,
+				"nvim-mode",
+			);
+			const client = await connectNvimRpc(nvimServerDefinition, {
+				dynamicPort: discoveredPort,
+			});
+			if (this.disposed) {
+				client.dispose();
+				return;
+			}
+			this.client = client;
+
+			client.onNotification((method, params) => {
+				if (method === "nvim_buf_lines_event") {
+					this.applyBufferLines(params);
+				} else if (method === "nvim-mode:diagnostics") {
+					this.applyDiagnostics(params);
+				}
+			});
+
+			// Starts attached to Neovim's initial empty scratch buffer.
+			// setFilePath() (called from configureLspForFile once the real
+			// file is known) switches this to the actual file via :edit.
+			await this.attachToCurrentBuffer();
+			this.modeBar.textContent = "-- NORMAL --";
+		} catch (err) {
+			this.modeBar.textContent = `nvim connection failed: ${String(err)}`;
+			console.error("[nvim-mode] connect failed", err);
+		}
+	}
+
+	/**
+	 * Switches Neovim's current buffer to the given real filesystem path
+	 * (reachable from inside the Alpine/Termux environment nvim runs in —
+	 * NOT necessarily the same path Acode's WebView sees for the file).
+	 * Re-attaches buffer sync and diagnostics, since :edit moves to a new
+	 * buffer handle.
+	 *
+	 * Known gap: this expects a plain filesystem path. Untitled buffers and
+	 * documents Acode can only reach via a cache copy need the same
+	 * real-path/cache-path resolution builtinAlpine.ts already does for
+	 * other LSP servers (see canUseRealPath/cacheDocumentUri there) — not
+	 * reimplemented here yet.
+	 */
+	async setFilePath(path: string): Promise<void> {
+		if (!this.client || !path || path === this.currentPath) return;
+		this.currentPath = path;
+		await this.connected;
+		if (!this.client) return;
+		await this.client.request("nvim_command", [
+			`edit ${escapeVimCommandArg(path)}`,
+		]);
+		await this.attachToCurrentBuffer();
+	}
+
+	private async attachToCurrentBuffer(): Promise<void> {
+		if (!this.client) return;
+		await this.client.request("nvim_buf_attach", [0, true, {}]);
+
+		// Route Neovim's own diagnostics (from whatever LSP client your
+		// init.lua attaches — Pyright via nvim-lspconfig, etc.) back to us,
+		// instead of running a second, separate LSP client inside Acode.
+		// Re-registered per buffer since `buffer = 0` binds to whichever
+		// buffer is current at creation time, and :edit moves to a new one.
+		await this.client.request("nvim_exec_lua", [
+			`
+			vim.api.nvim_create_autocmd("DiagnosticChanged", {
+			  buffer = 0,
+			  callback = function(args)
+			    vim.rpcnotify(0, "nvim-mode:diagnostics", vim.diagnostic.get(args.buf))
+			  end,
+			})
+			`,
+			[],
+		]);
+
+		this.diagnostics = [];
+		await this.syncCursorAndMode();
+	}
+
+	private diagnostics: Diagnostic[] = [];
+
+	private applyDiagnostics(params: unknown[]) {
+		const raw = (params[0] as NvimDiagnostic[]) || [];
+		const doc = this.view.state.doc;
+		this.diagnostics = raw.map((d) => {
+			const fromLine = Math.min(d.lnum + 1, doc.lines);
+			const toLine = Math.min((d.end_lnum ?? d.lnum) + 1, doc.lines);
+			const from = Math.min(doc.line(fromLine).from + d.col, doc.length);
+			const rawTo = doc.line(toLine).from + (d.end_col ?? d.col + 1);
+			const to = Math.min(Math.max(rawTo, from + 1), doc.length);
+			return {
+				from,
+				to,
+				severity: severityFromNvim(d.severity),
+				message: d.message,
+				source: d.source,
+			};
+		});
+		forceLinting(this.view);
+	}
+
+	getDiagnostics(): Diagnostic[] {
+		return this.diagnostics;
+	}
+
+	/**
+	 * Blocking LSP completion request through Neovim's own client — reuses
+	 * whatever language servers your init.lua already wires up (Pyright,
+	 * etc.) instead of Acode running a second, independent LSP connection.
+	 */
+	async requestCompletion(pos: number): Promise<NvimCompletionItem[]> {
+		if (!this.client) return [];
+		const line = this.view.state.doc.lineAt(pos);
+		const lua = `
+			local params = {
+			  textDocument = { uri = vim.uri_from_bufnr(0) },
+			  position = { line = ${line.number - 1}, character = ${pos - line.from} },
+			}
+			local clients = vim.lsp.get_clients({ bufnr = 0 })
+			if #clients == 0 then return vim.NIL end
+			local ok, result = pcall(function()
+			  return clients[1]:request_sync("textDocument/completion", params, 1000, 0)
+			end)
+			if not ok or not result then return vim.NIL end
+			return result.result or vim.NIL
+		`;
+		try {
+			const result = await this.client.request("nvim_exec_lua", [lua, []]);
+			return normalizeCompletionResult(result);
+		} catch (err) {
+			console.error("[nvim-mode] completion request failed", err);
+			return [];
+		}
+	}
+
+	private applyBufferLines(params: unknown[]) {
+		// nvim_buf_lines_event: [buf, changedtick, firstline, lastline, linedata, more]
+		const [, , firstline, lastline, linedata] = params as [
+			unknown,
+			unknown,
+			number,
+			number,
+			string[],
+			boolean,
+		];
+		const doc = this.view.state.doc;
+		const fromLine = Math.min(firstline + 1, doc.lines);
+		const from = doc.line(fromLine).from;
+		const toLine = lastline === -1 ? doc.lines : Math.min(lastline, doc.lines);
+		const to =
+			lastline === -1 || toLine >= doc.lines
+				? doc.length
+				: doc.line(toLine + 1).from;
+
+		const insert = linedata.join("\n") + (linedata.length ? "\n" : "");
+		this.view.dispatch({ changes: { from, to, insert } });
+	}
+
+	private async syncCursorAndMode() {
+		if (!this.client) return;
+		const [row, col] = (await this.client.request("nvim_win_get_cursor", [
+			0,
+		])) as [number, number];
+		const modeInfo = (await this.client.request("nvim_get_mode", [])) as {
+			mode: string;
+		};
+		this.modeBar.textContent = `-- ${modeLabels[modeInfo.mode] ?? modeInfo.mode.toUpperCase()} --`;
+
+		const line = this.view.state.doc.line(
+			Math.min(row, this.view.state.doc.lines),
+		);
+		const pos = Math.min(line.from + col, line.to);
+		this.view.dispatch({ selection: { anchor: pos } });
+	}
+
+	// Must be synchronous: CodeMirror's keymap `any` handler needs an
+	// immediate boolean, not a Promise (which is always truthy and would
+	// swallow every keystroke regardless of whether nvim recognized it).
+	tryHandleKey(e: KeyboardEvent): boolean {
+		if (!this.client) return false;
+		const key = toNvimKey(e);
+		if (!key) return false;
+		e.preventDefault();
+		void this.client
+			.request("nvim_input", [key])
+			.then(() => this.syncCursorAndMode())
+			.catch((err) => console.error("[nvim-mode] input failed", err));
+		return true;
+	}
+
+	destroy() {
+		this.disposed = true;
+		this.client?.dispose();
+		this.modeBar.remove();
+	}
+}
+
+// :edit splits on unescaped whitespace and treats a few characters
+// specially — escape what a real filesystem path could plausibly contain.
+function escapeVimCommandArg(path: string): string {
+	return path.replace(/([ \t%#\\])/g, "\\$1");
+}
+
+// LSP completion responses come as either a bare CompletionItem[] or a
+// CompletionList { isIncomplete, items }. Normalize to a flat array.
+function normalizeCompletionResult(result: unknown): NvimCompletionItem[] {
+	if (!result) return [];
+	const raw = Array.isArray(result)
+		? result
+		: (result as { items?: unknown[] })?.items;
+	if (!Array.isArray(raw)) return [];
+
+	const items: NvimCompletionItem[] = [];
+	for (const entry of raw) {
+		const i = entry as Record<string, unknown>;
+		if (typeof i.label !== "string") continue;
+		const label: string = i.label;
+		const textEdit = i.textEdit as { newText?: string } | undefined;
+		const insertText: string =
+			typeof i.insertText === "string"
+				? i.insertText
+				: (textEdit?.newText ?? label);
+		items.push({
+			label,
+			insertText,
+			detail: typeof i.detail === "string" ? i.detail : undefined,
+			kind: typeof i.kind === "number" ? i.kind : undefined,
+		});
+	}
+	return items;
+}
+
+let activePlugin: NvimModePlugin | null = null;
+
+export function getActiveNvimPlugin(): NvimModePlugin | null {
+	return activePlugin;
+}
+
+export const nvimModeViewPlugin = ViewPlugin.fromClass(
+	class {
+		plugin: NvimModePlugin;
+		constructor(view: EditorView) {
+			this.plugin = new NvimModePlugin(view);
+			activePlugin = this.plugin;
+		}
+		destroy() {
+			this.plugin.destroy();
+			activePlugin = null;
+		}
+	},
+);
+
+// High precedence so this intercepts keys before CodeMirror's own keymaps
+// (default keymap, closebrackets, etc.) get a chance to run.
+export const nvimModeKeymap = Prec.highest(
+	keymap.of([
+		{
+			any(_view, event) {
+				return activePlugin?.tryHandleKey(event) ?? false;
+			},
+		},
+	]),
+);
+
+export const nvimModeExtension = [nvimModeViewPlugin, nvimModeKeymap];
