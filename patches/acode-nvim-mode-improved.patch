+import { defineServer, installers } from "../lsp/providerUtils";
+import { sanitizeDefinition } from "../lsp/serverRegistry";
+import type { LspServerDefinition } from "../lsp/types";
+
+/*
+ * Neovim isn't an LSP server, but Acode's launcher/bridge plumbing (spawn a
+ * binary through the "axs" bridge, expose it over a local WebSocket) is
+ * protocol-agnostic — it's the exact same mechanism pyright/ty/pylsp already
+ * use. We reuse `defineServer` + the registry's own `sanitizeDefinition` to
+ * get a real, fully-normalized LspServerDefinition for free; this is never
+ * registered with the LSP server registry itself.
+ */
+
+// Minimal, well-known lazy.nvim bootstrap + nvim-lspconfig + Pyright +
+// Treesitter (python). This ONLY gets written if no init.lua already
+// exists (see the `test -f` guard below) — if you already have a real
+// config in the Alpine environment, this never touches it, and your own
+// setup is used as-is.
+const BOOTSTRAP_INIT_LUA = `
+local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
+if not vim.loop.fs_stat(lazypath) then
+	vim.fn.system({
+		"git", "clone", "--filter=blob:none",
+		"https://github.com/folke/lazy.nvim.git",
+		"--branch=stable", lazypath,
+	})
+end
+vim.opt.rtp:prepend(lazypath)
+
+require("lazy").setup({
+	{ "neovim/nvim-lspconfig" },
+	{
+		"nvim-treesitter/nvim-treesitter",
+		build = ":TSUpdate",
+		config = function()
+			require("nvim-treesitter.configs").setup({
+				ensure_installed = { "python" },
+				highlight = { enable = true },
+			})
+		end,
+	},
+})
+
+require("lspconfig").pyright.setup({})
+`.trim();
+
+function buildNvimInstallCommand(): string {
+	const heredoc = BOOTSTRAP_INIT_LUA.replace(/'/g, "'\\''");
+	return [
+		// nvim itself, plus git (lazy.nvim bootstrap clones from it) and a
+		// C toolchain (nvim-treesitter's :TSUpdate compiles parsers).
+		"apk add --no-cache neovim git python3 py3-pip build-base",
+		// Pyright — so nvim-lspconfig's default pyright setup finds it on
+		// PATH. Kept as a plain pip install here rather than piggybacking
+		// on Acode's own pyright installer, since that one's lifecycle is
+		// tied to Acode's separate LSP client, which vim mode bypasses.
+		"PIP_BREAK_SYSTEM_PACKAGES=1 pip install --no-cache-dir pyright",
+		'mkdir -p "$HOME/.config/nvim"',
+		// Never overwrite a real, existing config.
+		`if [ ! -f "$HOME/.config/nvim/init.lua" ]; then cat > "$HOME/.config/nvim/init.lua" <<'NVIM_MODE_EOF'\n${heredoc}\nNVIM_MODE_EOF\nfi`,
+	].join(" && \\\n");
+}
+
+export const nvimServerDefinition: LspServerDefinition = sanitizeDefinition(
+	defineServer({
+		id: "nvim-mode",
+		label: "Neovim (vim motions)",
+		languages: ["*"],
+		command: "nvim",
+		args: ["--embed"],
+		checkCommand: "which nvim",
+		installer: installers.shell({
+			executable: "nvim",
+			command: buildNvimInstallCommand(),
+			label: "Neovim (vim motions)",
+		}),
+		transport: {
+			options: { raw: true }, // byte-safe framing — see transport.ts's `raw` option
+		},
+		enabled: false, // gated behind a user-facing "Vim mode" toggle, not autostarted
+	}),
+);
+
+export default nvimServerDefinition;
